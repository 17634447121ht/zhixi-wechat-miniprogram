.about-page { text-align: center; }
.logo { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin: 30rpx auto 0; border-radius: 18rpx; color: #fff; background: #176b4b; font-family: serif; font-size: 46rpx; font-weight: 800; }
.slogan { max-width: 520rpx; margin: 32rpx auto 0; color: #536159; font-size: 27rpx; line-height: 1.7; }
.menu-list { text-align: left; }
.reset { min-height: 76rpx; margin-top: 16rpx; color: #c1514d; background: transparent; font-size: 24rpx; line-height: 76rpx; }
.reset::after { border: 0; }
.copyright { margin-top: 48rpx; color: #9aa49f; font-size: 20rpx; }
