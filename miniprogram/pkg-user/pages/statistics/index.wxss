.period-tabs { display: grid; grid-template-columns: repeat(4,1fr); gap: 6rpx; padding: 6rpx; border-radius: 14rpx; background: #e9eeeb; }
.period { padding: 16rpx 8rpx; border-radius: 10rpx; color: #6d7a73; font-size: 23rpx; text-align: center; }
.period--active { color: #176c4c; background: #fff; font-weight: 700; }
.stat-hero { margin-top: 18rpx; padding: 26rpx; border-radius: 18rpx; color: #fff; background: #176b4b; }
.stat-hero-label { color: rgba(255,255,255,.72); font-size: 23rpx; }
.stat-hero-value { margin-top: 8rpx; font-size: 44rpx; font-weight: 850; }
.stat-hero-value text { font-size: 23rpx; font-weight: 500; }
.streak { min-width: 116rpx; padding: 14rpx; border-radius: 12rpx; background: rgba(255,255,255,.12); text-align: center; }
.streak-value { font-size: 34rpx; font-weight: 850; }
.streak-label { margin-top: 4rpx; color: rgba(255,255,255,.7); font-size: 19rpx; }
.stat-hero-foot { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(255,255,255,.18); color: rgba(255,255,255,.75); font-size: 22rpx; }
.quick-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 14rpx; }
.quick { display: grid; grid-template-columns: 48rpx 1fr 16rpx; align-items: center; gap: 12rpx; padding: 18rpx; border: 1rpx solid #e1e9e4; border-radius: 14rpx; background: #fff; }
.quick-icon { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 10rpx; color: #fff; background: #187653; font-weight: 800; }
.quick-icon--blue { background: #4b74c4; }
.weak-row { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 0; border-bottom: 1rpx solid #e7ece9; }
.weak-row:last-child { border-bottom: 0; }
.weak-value { padding: 8rpx 14rpx; border-radius: 11rpx; color: #b44d49; background: #fff0ef; font-weight: 800; }
