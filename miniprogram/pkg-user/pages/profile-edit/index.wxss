.avatar-section { padding: 48rpx 0 18rpx; text-align: center; }
.avatar-button { position: relative; width: 142rpx; height: 142rpx; margin: 0 auto; padding: 0; border-radius: 50%; background: transparent; overflow: visible; }
.avatar-button::after { border: 0; }
.camera { position: absolute; right: -2rpx; bottom: 0; display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border: 4rpx solid #f6f8f5; border-radius: 50%; color: #fff; background: #187653; font-size: 18rpx; font-weight: 800; }
