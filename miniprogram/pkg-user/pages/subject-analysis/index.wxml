<view class="page">
  <view class="loading" wx:if="{{loading}}"><text class="dot"></text><text class="dot"></text><text class="dot"></text></view>
  <block wx:else>
    <view class="notice">正确率来自所有已提交答案；题量越多，分析越有参考价值。</view>
    <view class="ability-card" wx:for="{{subjects}}" wx:key="id" data-id="{{item.id}}" bind:tap="open">
      <view class="row--between"><view class="row gap-md"><view class="circle-icon">{{item.icon}}</view><view><view class="title-md">{{item.name}}</view><view class="caption mt-xs">已答 {{item.attempts}} 次 · 覆盖 {{item.answered}} / {{item.total}} 题</view></view></view><view class="ability-score">{{item.accuracy}}%</view></view>
      <view class="mt-md"><progress-bar value="{{item.accuracy}}" tone="{{item.accuracy < 60 ? 'orange' : 'green'}}" /></view>
    </view>
    <view class="center mt-lg"><button class="button button--outline" bind:tap="goBank">去题库继续练习</button></view>
  </block>
</view>
