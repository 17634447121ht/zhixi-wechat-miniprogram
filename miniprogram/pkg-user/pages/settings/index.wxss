.settings-card { padding: 0 22rpx; border: 1rpx solid #e1e9e4; border-radius: 18rpx; background: #fff; }
.setting-row { display: flex; align-items: center; gap: 22rpx; min-height: 122rpx; border-bottom: 1rpx solid #e7ece9; }
.setting-row:last-child { border-bottom: 0; }
.number-field { display: flex; align-items: center; gap: 8rpx; color: #718078; font-size: 22rpx; }
.number-field input { width: 108rpx; height: 64rpx; border: 1rpx solid #dbe4df; border-radius: 16rpx; color: #187653; background: #f8faf9; font-size: 26rpx; font-weight: 750; text-align: center; }
