.subject-hero { background: #176b4b; }
.subject-eyebrow { color: rgba(255,255,255,.72); }
.subject-numbers { display: flex; gap: 28rpx; margin-top: 20rpx; color: rgba(255,255,255,.76); font-size: 21rpx; }
.subject-numbers .number { color: #fff; font-size: 28rpx; font-weight: 800; }
.practice-button { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-height: 138rpx; gap: 8rpx; padding: 22rpx; border-radius: 16rpx; color: #fff; background: #277858; font-size: 27rpx; font-weight: 750; line-height: 1.3; text-align: left; }
.practice-button::after { border: 0; }
.practice-button--orange { background: #c96e3d; }
.practice-button--green { background: #277858; }
.practice-icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 10rpx; background: rgba(255,255,255,.16); font-size: 20rpx; }
.practice-note { color: rgba(255,255,255,.76); font-size: 20rpx; font-weight: 400; }
.chapter-card { padding-top: 4rpx; padding-bottom: 4rpx; }
.chapter-row { display: flex; align-items: center; gap: 16rpx; min-height: 92rpx; border-bottom: 1rpx solid #e7ece9; }
.chapter-row:last-child { border-bottom: 0; }
.chapter-index { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 16rpx; color: #187653; background: #e7f4ed; font-size: 22rpx; font-weight: 750; }
