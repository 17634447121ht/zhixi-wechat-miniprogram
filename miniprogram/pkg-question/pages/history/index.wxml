<view class="page">
  <view class="loading" wx:if="{{loading}}"><text class="dot"></text><text class="dot"></text><text class="dot"></text></view>
  <empty-state wx:elif="{{!items.length}}" icon="历" title="还没有做题记录" description="完成练习后，可以在这里回看题卡和答案。" action-text="去题库" bind:action="goBank" />
  <block wx:else>
    <view class="history-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bind:tap="open">
      <view class="date-block"><view class="date">{{item.date}}</view><view class="time">{{item.time}}</view></view>
      <view class="grow"><view class="title-md">{{item.title}}</view><view class="caption mt-xs">{{item.mode}} · {{item.answered}} / {{item.total}} 题 · {{item.durationLabel}}</view><view class="status {{item.status === 'FINISHED' ? 'status--done' : ''}}">{{item.status === 'FINISHED' ? '已完成' : '未完成'}}</view></view>
      <view class="score">{{item.accuracy}}%</view>
    </view>
  </block>
</view>
