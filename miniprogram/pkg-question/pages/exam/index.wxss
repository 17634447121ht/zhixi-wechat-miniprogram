.exam-hero { display: flex; align-items: center; gap: 20rpx; padding: 26rpx; border-radius: 18rpx; color: #fff; background: #c96e3d; }
.exam-hero--blue { background: #4d72b6; }
.exam-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; flex: 0 0 auto; border-radius: 14rpx; background: rgba(255,255,255,.16); font-size: 32rpx; font-weight: 800; }
.exam-description { margin-top: 9rpx; color: rgba(255,255,255,.82); font-size: 24rpx; }
.section-heading { margin: 28rpx 0 14rpx; }
.subject-card { display: flex; align-items: center; gap: 18rpx; margin-bottom: 14rpx; padding: 22rpx; border: 1rpx solid #e1e9e4; border-radius: 18rpx; background: #fff; }
