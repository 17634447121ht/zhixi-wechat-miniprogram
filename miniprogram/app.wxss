page {
  --brand: #187653;
  --brand-strong: #0d5e40;
  --brand-soft: #e7f4ed;
  --ink: #17221c;
  --muted: #708078;
  --line: #e5ebe7;
  --surface: #ffffff;
  --canvas: #f7f8f7;
  --warning: #f0a23a;
  --danger: #d95b58;
  --blue: #3975d1;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, switch, slider, scroll-view {
  box-sizing: border-box;
}

button::after { border: 0; }

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.page--flush { padding-top: 0; }
.safe-bottom { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }

.hero {
  padding: 30rpx 28rpx;
  border-radius: 20rpx;
  color: #fff;
  background: #176b4b;
}

.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-subtitle { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 24rpx; }
.hero-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 22rpx;
}

.card + .card { margin-top: 16rpx; }
.section { margin-top: 28rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.section-subtitle { margin-top: 4rpx; color: var(--muted); font-size: 22rpx; }
.eyebrow { color: var(--brand); font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.title-xl { font-size: 44rpx; line-height: 1.2; font-weight: 800; }
.title-lg { font-size: 34rpx; line-height: 1.35; font-weight: 750; }
.title-md { font-size: 28rpx; line-height: 1.45; font-weight: 700; }
.body { color: #34443b; line-height: 1.65; }
.muted { color: var(--muted); }
.caption { color: var(--muted); font-size: 23rpx; line-height: 1.55; }
.brand { color: var(--brand); }
.danger { color: var(--danger); }
.warning { color: var(--warning); }
.strong { font-weight: 700; }
.center { text-align: center; }

.row { display: flex; align-items: center; }
.row--between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.row--top { align-items: flex-start; }
.grow { flex: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }
.gap-sm { gap: 12rpx; }
.gap-md { gap: 20rpx; }
.mt-xs { margin-top: 8rpx; }
.mt-sm { margin-top: 16rpx; }
.mt-md { margin-top: 20rpx; }
.mt-lg { margin-top: 30rpx; }
.mb-sm { margin-bottom: 16rpx; }
.divider { height: 1rpx; margin: 24rpx 0; background: var(--line); }

.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }

.stat-value { font-size: 34rpx; font-weight: 780; line-height: 1.2; }
.stat-label { margin-top: 6rpx; color: var(--muted); font-size: 22rpx; }
.stat-card { padding: 18rpx; border-radius: 14rpx; background: #f8faf8; border: 1rpx solid var(--line); }

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 26rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.button--primary { color: #fff; background: var(--brand); }
.button--secondary { color: var(--brand-strong); background: var(--brand-soft); }
.button--outline { color: var(--brand); background: #fff; border: 2rpx solid #b7d8c8; }
.button--ghost { color: #55645c; background: #f0f4f1; }
.button--danger { color: var(--danger); background: #fff0ef; }
.button--sm { min-height: 60rpx; padding: 0 20rpx; border-radius: 12rpx; font-size: 24rpx; }
.button--disabled { opacity: .45; box-shadow: none; }
.button-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  color: #536159;
  background: #edf1ee;
  border: 1rpx solid transparent;
  font-size: 24rpx;
}
.chip--active { color: var(--brand-strong); background: var(--brand-soft); border-color: #a7d2bd; font-weight: 700; }
.chip--disabled { opacity: .38; }
.tag { display: inline-block; padding: 6rpx 12rpx; border-radius: 8rpx; color: var(--brand); background: var(--brand-soft); font-size: 20rpx; font-weight: 650; }
.tag--orange { color: #9b5d0a; background: #fff2dc; }
.tag--red { color: #a5413e; background: #ffebea; }
.tag--blue { color: #315eae; background: #eaf1ff; }

.entry-card { min-height: 152rpx; padding: 22rpx; border-radius: 18rpx; color: #fff; }
.entry-card--word { background: #277858; }
.entry-card--civil { background: #c96e3d; }
.entry-card--postgrad { background: #4d72b6; }
.entry-icon { font-size: 34rpx; }
.entry-title { margin-top: 12rpx; font-size: 28rpx; font-weight: 750; }
.entry-meta { margin-top: 6rpx; color: rgba(255,255,255,.78); font-size: 21rpx; }

.menu-list { overflow: hidden; padding: 0 22rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 18rpx; }
.menu-item { display: flex; align-items: center; min-height: 88rpx; gap: 16rpx; border-bottom: 1rpx solid var(--line); }
.menu-item:last-child { border-bottom: 0; }
.menu-icon { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; border-radius: 12rpx; background: var(--brand-soft); font-size: 25rpx; }
.menu-arrow { color: #a4aea8; }

.list-item { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.list-item:last-child { border-bottom: 0; }
.circle-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; flex: 0 0 auto; border-radius: 14rpx; color: var(--brand-strong); background: var(--brand-soft); font-weight: 800; }

.progress-track { height: 10rpx; overflow: hidden; border-radius: 6rpx; background: #e7ece8; }
.progress-fill { height: 100%; min-width: 0; border-radius: inherit; background: #2b8a64; transition: width .25s ease; }
.progress-fill--orange { background: #df8249; }
.progress-fill--blue { background: #597fc4; }

.notice { padding: 18rpx 20rpx; border-radius: 14rpx; color: #3a5e4b; background: #edf7f1; border: 1rpx solid #d2e9dc; line-height: 1.55; }
.notice--warning { color: #7b571b; background: #fff7e9; border-color: #f5dfb8; }
.notice--danger { color: #8c4340; background: #fff0ef; border-color: #f5cecc; }

.field { margin-top: 24rpx; }
.field-label { margin-bottom: 12rpx; font-size: 25rpx; font-weight: 700; }
.input { width: 100%; height: 80rpx; padding: 0 22rpx; border: 1rpx solid #dce5df; border-radius: 14rpx; background: #fff; }
.textarea { width: 100%; min-height: 170rpx; padding: 20rpx 22rpx; border: 1rpx solid #dce5df; border-radius: 14rpx; background: #fff; }

.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #dceee5; }
.avatar--lg { width: 116rpx; height: 116rpx; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; color: var(--brand); font-size: 42rpx; font-weight: 800; }

.fixed-actions { position: sticky; z-index: 8; bottom: 0; margin: 24rpx -24rpx -40rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: #f7f8f7; border-top: 1rpx solid var(--line); }

.empty { padding: 56rpx 28rpx; text-align: center; }
.empty-icon { font-size: 54rpx; opacity: .72; }
.empty-title { margin-top: 14rpx; font-size: 28rpx; font-weight: 700; }
.empty-desc { margin: 12rpx auto 0; max-width: 480rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }

.loading { padding: 90rpx 0; color: var(--muted); text-align: center; }
.dot { display: inline-block; width: 10rpx; height: 10rpx; margin: 0 6rpx; border-radius: 50%; background: var(--brand); animation: pulse 1.1s infinite ease-in-out; }
.dot:nth-child(2) { animation-delay: .14s; }
.dot:nth-child(3) { animation-delay: .28s; }
@keyframes pulse { 0%, 60%, 100% { opacity: .25; transform: scale(.8); } 30% { opacity: 1; transform: scale(1); } }

.bar-list { display: flex; flex-direction: column; gap: 20rpx; }
.bar-row { display: grid; grid-template-columns: 150rpx 1fr 72rpx; align-items: center; gap: 16rpx; }
.trend { display: flex; align-items: flex-end; justify-content: space-between; height: 190rpx; gap: 12rpx; }
.trend-col { flex: 1; min-width: 0; text-align: center; }
.trend-bar-wrap { display: flex; align-items: flex-end; height: 140rpx; }
.trend-bar { width: 100%; min-height: 8rpx; border-radius: 6rpx 6rpx 2rpx 2rpx; background: #2b8a64; }
.trend-label { margin-top: 10rpx; color: var(--muted); font-size: 20rpx; }

.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
