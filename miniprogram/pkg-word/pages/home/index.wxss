.word-page { padding-top: 12rpx; }
.section-label { margin-bottom: 12rpx; color: #77827c; font-size: 22rpx; font-weight: 600; }
.book-section { padding: 16rpx 0 26rpx; border-bottom: 1rpx solid #e4e9e6; }
.book-row { display: flex; align-items: center; min-height: 72rpx; }
.book-name { font-size: 31rpx; font-weight: 700; line-height: 1.35; }
.book-meta { margin-top: 5rpx; color: #7a857e; font-size: 21rpx; }
.change-book { color: #187653; font-size: 23rpx; }
.arrow { margin-left: 16rpx; color: #a2aaa5; font-size: 32rpx; }
.book-progress { margin-top: 18rpx; }

.content-section { margin-top: 30rpx; }
.task-list,
.tool-list { border-top: 1rpx solid #e4e9e6; }
.task-row,
.tool-row { display: flex; align-items: center; border-bottom: 1rpx solid #e4e9e6; }
.task-row { min-height: 112rpx; }
.tool-row { min-height: 84rpx; font-size: 27rpx; }
.task-mark,
.tool-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; color: #39705a; background: #edf4f0; font-weight: 700; }
.task-mark { width: 54rpx; height: 54rpx; margin-right: 18rpx; border-radius: 50%; font-size: 22rpx; }
.tool-mark { width: 44rpx; height: 44rpx; margin-right: 18rpx; border-radius: 12rpx; font-size: 20rpx; }
.task-title { font-size: 28rpx; font-weight: 700; }
.task-meta { margin-top: 5rpx; color: #7a857e; font-size: 21rpx; }
.task-count { color: #17221c; font-size: 31rpx; font-weight: 700; }
.task-count text { color: #7a857e; font-size: 20rpx; font-weight: 400; }
