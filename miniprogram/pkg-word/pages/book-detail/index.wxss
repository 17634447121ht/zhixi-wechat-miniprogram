.book-hero { min-height: 238rpx; padding: 28rpx; border-radius: 18rpx; color: #fff; background: #277858; }
.book-hero--orange { background: #c96e3d; }
.book-hero--blue { background: #4d72b6; }
.book-code { color: rgba(255,255,255,.72); font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.book-aa { margin-top: 22rpx; font-family: Georgia,serif; font-size: 52rpx; font-weight: 800; }
.book-title { margin-top: 22rpx; font-size: 31rpx; font-weight: 800; }
.book-desc { margin-top: 9rpx; color: rgba(255,255,255,.76); font-size: 23rpx; }
.detail-grid { display: grid; grid-template-columns: repeat(3,1fr); text-align: center; }
.detail-grid > view { border-right: 1rpx solid #e5ebe7; }
.detail-grid > view:last-child { border-right: 0; }
.value { color: #187653; font-size: 32rpx; font-weight: 800; }
