.word-progress { padding: 0 4rpx 12rpx; }
.rating-panel { margin-top: 22rpx; padding: 24rpx 0 calc(12rpx + env(safe-area-inset-bottom)); }
.rating-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 10rpx; margin-top: 18rpx; }
.rating { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100rpx; padding: 12rpx 4rpx; border-radius: 20rpx; color: #fff; background: #79867f; font-size: 23rpx; font-weight: 700; line-height: 1.2; }
.rating::after { border: 0; }
.rating-note { display: block; margin-top: 9rpx; color: rgba(255,255,255,.72); font-size: 18rpx; font-weight: 400; }
.rating--unknown { background: #d45a56; }
.rating--fuzzy { background: #df8d3c; }
.rating--known { background: #3d79be; }
.rating--mastered { background: #25805b; }
.finish { padding: 150rpx 20rpx 40rpx; text-align: center; }
.finish-icon { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin: 0 auto; border-radius: 50%; color: #fff; background: #187653; font-size: 44rpx; font-weight: 800; }
