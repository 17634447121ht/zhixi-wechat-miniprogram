.home-page { padding-top: 34rpx; }

.home-head { display: flex; align-items: center; gap: 20rpx; }
.greeting { color: #17221c; font-size: 36rpx; font-weight: 760; line-height: 1.35; }
.head-note { margin-top: 8rpx; color: #7a8780; font-size: 23rpx; }
.streak-chip { flex: 0 0 auto; padding: 12rpx 18rpx; border-radius: 999rpx; color: #526159; background: #edf1ee; font-size: 21rpx; }
.streak-number { color: #187653; font-size: 25rpx; font-weight: 800; }

.focus-card { display: flex; align-items: center; gap: 24rpx; min-height: 174rpx; margin-top: 34rpx; padding: 30rpx; border-radius: 24rpx; color: #fff; background: #187653; }
.focus-copy { flex: 1; min-width: 0; }
.focus-label { color: rgba(255,255,255,.72); font-size: 21rpx; }
.focus-title { overflow: hidden; margin-top: 9rpx; font-size: 32rpx; font-weight: 760; text-overflow: ellipsis; white-space: nowrap; }
.focus-meta { margin-top: 10rpx; color: rgba(255,255,255,.78); font-size: 22rpx; }
.focus-action { display: flex; align-items: center; justify-content: center; min-width: 92rpx; height: 64rpx; padding: 0 22rpx; border-radius: 18rpx; color: #126143; background: #fff; font-size: 24rpx; font-weight: 750; }

.section-block { margin-top: 38rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; min-height: 46rpx; margin-bottom: 18rpx; }
.section-name { color: #17221c; font-size: 29rpx; font-weight: 750; }
.section-link { padding: 8rpx 0 8rpx 14rpx; color: #187653; font-size: 22rpx; }
.section-actions { display: flex; align-items: center; }
.action-divider { padding-left: 12rpx; color: #bcc4bf; }

.quick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.quick-item { display: flex; min-height: 174rpx; align-items: center; flex-direction: column; justify-content: center; padding: 20rpx 10rpx; border: 1rpx solid #e4eae6; border-radius: 22rpx; background: #fff; }
.quick-icon { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 18rpx; font-size: 25rpx; font-weight: 800; }
.quick-icon--word { color: #176e4f; background: #e8f4ed; }
.quick-icon--civil { color: #9a5b22; background: #fff1e3; }
.quick-icon--postgrad { color: #3b609e; background: #ebf1fb; }
.quick-title { margin-top: 14rpx; color: #26352d; font-size: 25rpx; font-weight: 700; }
.quick-meta { margin-top: 5rpx; color: #8b9790; font-size: 19rpx; }

.progress-card { padding: 28rpx; border: 1rpx solid #e4eae6; border-radius: 22rpx; background: #fff; }
.progress-gap { height: 25rpx; }

.recent-list { overflow: hidden; padding: 0 26rpx; border: 1rpx solid #e4eae6; border-radius: 22rpx; background: #fff; }
.recent-row { display: flex; align-items: center; gap: 16rpx; min-height: 102rpx; border-bottom: 1rpx solid #e9eeeb; }
.recent-row:last-child { border-bottom: 0; }
.recent-title { overflow: hidden; color: #26352d; font-size: 25rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.recent-meta { margin-top: 7rpx; color: #88938d; font-size: 20rpx; }
.recent-score { color: #187653; font-size: 25rpx; font-weight: 750; }
.recent-arrow { color: #aab3ad; font-size: 32rpx; }
.empty-note { padding: 28rpx; border-radius: 20rpx; color: #7d8982; background: #f0f3f1; font-size: 23rpx; text-align: center; }
